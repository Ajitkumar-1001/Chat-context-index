# Copy to the ignored repository .env.live-smoke and fill in locally.
# Never paste credentials into chat or commit the populated file.
# Presets: openai, gemini, anthropic, groq, openrouter, ollama.
# Or use any provider label and set its OpenAI-compatible CCI_BASE_URL below.
CCI_PROVIDER=gemini
CCI_MODEL=
CCI_API_KEY=
# Optional for presets; required for other providers. Include the API's version path.
# CCI_BASE_URL=https://your-provider.example/v1
# Optional capabilities: max_tokens or max_completion_tokens; json_object or prompt.
# CCI_TOKEN_LIMIT_FIELD=max_tokens
# CCI_RESPONSE_FORMAT=json_object
# Local loopback servers do not require an API key.
# Existing OPENAI_API_KEY + OPENAI_MODEL files remain supported when CCI_PROVIDER is unset.
