    <script>
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      const toc = document.querySelector<HTMLElement>('.toc-list')!;
      const sections = [...document.querySelectorAll<HTMLElement>('main section[data-section]')];

      /** Nav buttons scroll their section into view; there are no #fragment routes. */
      function useScrollIntoView() {
        toc.addEventListener('click', (event) => {
          const button = (event.target as Element).closest<HTMLButtonElement>('button[data-target]');
          const target = sections.find((s) => s.dataset.section === button?.dataset.target);
          if (!target) return;
          target.classList.add('in-view');
          target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
          // Move keyboard and screen-reader focus with the scroll.
          const heading = target.querySelector('h2');
          heading?.setAttribute('tabindex', '-1');
          heading?.focus({ preventScroll: true });
        });
      }

      /** Sections fade in once as they first scroll into view. */
      function useScrollMotion() {
        if (reduceMotion.matches) return;
        // Sections already on screen stay put; only those below the fold start hidden, so nothing flashes.
        for (const s of sections) if (s.getBoundingClientRect().top < innerHeight) s.classList.add('in-view');
        document.documentElement.classList.add('motion');
        const reveal = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('in-view');
              reveal.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        for (const s of sections) if (!s.classList.contains('in-view')) reveal.observe(s);
      }

      /** Reports the section under the reading line ('' while above the first section). */
      function useSectionView(onChange: (section: string) => void) {
        let current: string | undefined;
        let queued = false;
        const update = () => {
          queued = false;
          const line = innerHeight * 0.35;
          let section = '';
          for (const s of sections) if (s.getBoundingClientRect().top <= line) section = s.dataset.section!;
          // The last sections are too short to reach the line; the page bottom selects the last one.
          if (innerHeight + scrollY >= document.documentElement.scrollHeight - 2) {
            section = sections.at(-1)?.dataset.section ?? section;
          }
          if (section === current) return;
          current = section;
          onChange(section);
        };
        const schedule = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        };
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('resize', schedule);
        update();
      }

      useScrollIntoView();
      useScrollMotion();
      useSectionView((section) => {
        for (const button of toc.querySelectorAll<HTMLButtonElement>('button[data-target]')) {
          if (button.dataset.target !== section) {
            button.removeAttribute('aria-current');
            continue;
          }
          button.setAttribute('aria-current', 'location');
          // Keep the active button visible when the nav scrolls sideways on narrow screens.
          toc.scrollTo({ left: button.offsetLeft - (toc.clientWidth - button.offsetWidth) / 2 });
        }
      });
    </script>
