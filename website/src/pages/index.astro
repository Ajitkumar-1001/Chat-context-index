---
import { Code } from 'astro:components';
// Only public evidence files are imported; the page is rebuilt from them.
import verification from '../../../evaluations/results/production-readiness-20260924/execution/release-0.1.0-verification.json';
import packages from '../../../evaluations/results/production-readiness-20260924/execution/release-0.1.0-package-memory.json';
import githubPackages from '../../../evaluations/results/production-readiness-20260924/execution/github-packages-npm-0.1.0-verification.json';
import smoke from '../../../evaluations/results/production-readiness-20260924/execution/live-smoke-candidate-004-summary.json';
import perfSummary from '../../../evaluations/results/production-readiness-20260924/execution/hosted-performance-36094491463-summary.json';
import recallLexical from '../../../evaluations/results/release-readiness/dev-recall-lexical-20260924.json';
import recallTree from '../../../evaluations/results/release-readiness/dev-recall-tree-20260924.json';

const repo = 'https://github.com/Ajitkumar-1001/Chat-context-index';
const blob = `${repo}/blob/main`;
const evidencePath = `${blob}/evaluations/results/production-readiness-20260924`;
const smokeReport = `${evidencePath}/execution/live-smoke-candidate-004-summary.json`;
const candidateReport = `${evidencePath}/execution/release-0.1.0-verification.json`;
const performanceRun = perfSummary.performance_run_url;
const performanceReport = `${evidencePath}/execution/hosted-performance-36094491463-summary.json`;
const pypi = verification.publication.pypi;
const npmRelease = verification.publication.npm;
const approvedHash = (name: string) => verification.artifacts.find((a) => a.filename === name)?.sha256;
if (
  packages.ci.GITHUB_SHA !== verification.source_commit ||
  packages.ci.GITHUB_RUN_ID !== verification.ci_run_id ||
  packages.source_report_sha256 !== verification.canonical_package_report_sha256 ||
  JSON.stringify(packages.artifacts) !== JSON.stringify(verification.artifacts) ||
  perfSummary.source_sha !== verification.source_commit ||
  perfSummary.ci_run_id !== verification.ci_run_id ||
  JSON.stringify(perfSummary.artifacts) !== JSON.stringify(verification.artifacts) ||
  pypi.files.length !== 2 ||
  pypi.files.some((file) => approvedHash(file.filename) !== file.sha256) ||
  githubPackages.source_commit !== verification.source_commit ||
  githubPackages.candidate_run_id !== verification.publication.release_run_id ||
  githubPackages.approved_archive.sha256 !== approvedHash(githubPackages.approved_archive.filename)
) throw new Error('Published evidence source, run, or archive mismatch');
// The live smoke predates this build; it is shown as earlier-candidate evidence only.
if (packages.artifacts.some((artifact) => artifact.sha256 === smoke.wheel_sha256)) {
  throw new Error('Smoke wording assumes it tested an earlier wheel');
}
const publishedWheel = pypi.files.find((file) => file.filename.endsWith('.whl'))!;
const hosted = {
  source_sha: verification.source_commit,
  run_url: verification.ci_run_url,
  all_ci_jobs: verification.jobs_passed,
  matrix_cells: verification.package_matrix_jobs_passed,
  writer_reader_checks_per_cell: packages.checks.length,
  tests: { python_passed: verification.python_tests_passed, node_passed: verification.node_tests_passed },
  artifacts: packages.artifacts,
  cells: verification.matrix,
};
// Gate wording mirrors docs/release-status.md; update both together.
const asOf = 'September 25, 2026 (UTC)';

const toc = [
  ['summary', 'Summary'],
  ['gates', 'Gates'],
  ['compatibility', 'Compatibility'],
  ['performance', 'Performance'],
  ['quality', 'Quality'],
  ['install', 'Try it'],
  ['limits', 'Limits'],
  ['artifacts', 'Artifacts'],
] as const;

type Status = 'pass' | 'open' | 'blocked';
const statusLabel: Record<Status, string> = { pass: 'Passed', open: 'Not run', blocked: 'Blocked' };

const ms = (n: number) => `${n.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 })} ms`;
const pct = (n: number) => `${Math.round(n * 100)}%`;
const minor = (v: string) => v.split('.').slice(0, 2).join('.');
const major = (v: string) => v.replace(/^v/, '').split('.')[0];

const perfPython10k = perfSummary.jobs.find((job) => job.language === 'python' && job.messages === 10000);
const perfTypescript10k = perfSummary.jobs.find((job) => job.language === 'typescript' && job.messages === 10000);
const perfPython100k = perfSummary.jobs.find((job) => job.language === 'python' && job.messages === 100000);
const perfTypescript100k = perfSummary.jobs.find((job) => job.language === 'typescript' && job.messages === 100000);
if (!perfPython10k || !perfTypescript10k || !perfPython100k || !perfTypescript100k) {
  throw new Error('Missing performance observation');
}
const hostedTargetsPassed = perfSummary.jobs.every((job) => job.status === 'PASS_HOSTED_OBSERVATION');
const earlierColdSearch = perfSummary.previous_candidate.ten_thousand_filesystem_cold_search_p95_ms;

const gates: { name: string; status: Status; evidence: string; href?: string }[] = [
  { name: 'Python regression', status: 'pass', evidence: `${hosted.tests.python_passed} tests passed for published source ${hosted.source_sha.slice(0, 8)}, including Redis, evaluator, performance-gate, and release-control checks.` },
  { name: 'TypeScript regression', status: 'pass', evidence: `${hosted.tests.node_passed} Node tests passed for the same source; TypeScript typecheck and package builds passed.` },
  { name: 'Static checks', status: 'pass', evidence: 'Hosted Python lint/typecheck, TypeScript typecheck, and bounded evaluator static checks passed.' },
  { name: 'Cross-language retrieval', status: 'pass', evidence: 'A shared fixture compares ordered search(), retrieve(), and prepared-context output across runtimes, including correction and duplicate cases.' },
  { name: 'Cache failure accounting', status: 'pass', evidence: 'Python stats() reports Redis errors and SQLite fallback lookups and hits; real-Redis failure tests exercise these counters. TypeScript has no Redis memo backend.' },
  { name: 'Installed packages', status: 'pass', evidence: `Wheel, sdist, and npm archive installed outside the checkout; all ${packages.checks.length} writer/reader combinations, all ${packages.migration_checks.length} schema-version-1 migration combinations, the TypeScript consumer typecheck, and package documentation passed.`, href: `${evidencePath}/execution/release-0.1.0-package-memory.json` },
  { name: 'Hosted package matrix', status: 'pass', evidence: `All ${hosted.matrix_cells} Python 3.11–3.14 × Node 22/24 × Ubuntu x64/macOS arm64 cells passed with matching source and archive hashes.`, href: hosted.run_url },
  { name: 'CI artifacts and security', status: 'pass', evidence: 'CI passed security scans and candidate inspection. The owner approved the exact archive manifest for this source. The release run rebuilt and re-tested the archives on the tag, confirmed they byte-match the approved SHA-256 values, and published them without another rebuild.', href: candidateReport },
  { name: 'Linux performance (hosted)', status: hostedTargetsPassed ? 'pass' : 'blocked', evidence: `Every 10k-message hosted target passed. Filesystem-cold first search p95 was ${ms(perfPython10k.filesystem_cold_search_p95_ms)} (Python) and ${ms(perfTypescript10k.filesystem_cold_search_p95_ms)} (TypeScript), down from ${ms(earlierColdSearch.python)} and ${ms(earlierColdSearch.typescript)} on the earlier candidate. The 100k observations completed with ${perfSummary.measurement_scope.concurrency_errors_all_jobs} concurrency errors. Fixed 4-CPU/8-GiB reference qualification remains open.`, href: performanceReport },
  { name: 'Installed-package live smoke', status: 'open', evidence: `Not yet run for the published wheel ${publishedWheel.sha256.slice(0, 8)}…. Earlier candidate wheel ${smoke.wheel_sha256.slice(0, 8)}… passed: eight calls, 1,066 input / 308 output tokens, $0.0010898 estimated cost, and original Oslo evidence recovered after reopening.`, href: smokeReport },
  { name: 'Quality, cost, and human review', status: 'open', evidence: 'Three frozen held-out trials, real-provider cache measurements, and answer review remain open; sustained capacity and the next paid allocation are unverified. Two developer-adoption bundles were prepared for the earlier candidate e762f7bd and must be rebuilt with the published archives; no participants have run them yet.' },
  { name: 'Website public availability', status: 'blocked', evidence: 'Vercel production deployments report success, but their URLs and the repository homepage redirect to Vercel login; public access is unverified.' },
  { name: 'PyPI publication', status: 'pass', evidence: `chat-context-index ${verification.version} was published from tag ${verification.tag} through GitHub trusted publishing, after the protected release environment was approved. Both PyPI files match the approved SHA-256 values.`, href: pypi.url },
  { name: 'GitHub Packages publication', status: 'pass', evidence: `${githubPackages.package} ${githubPackages.version} was published from the approved npm archive by a manual workflow: release controls passed against the owner’s approval, only the package name changed, and a fresh install from the registry recalled a stored message. Installing needs a read:packages token even though the package is public.`, href: githubPackages.publish_run_url },
  { name: 'npmjs publication', status: 'blocked', evidence: 'Not published. The release job stopped with ENEEDAUTH because npm 2FA and a publishing token are not configured. Once a token is configured, re-running that job (with release-environment approval, within GitHub’s re-run window) can publish the same approved archive.', href: npmRelease.job_url },
];

const cells = hosted.cells;
const pythons = [...new Set(cells.map((c) => minor(c.python)))];
const matrixRows = [...new Set(cells.map((c) => `${c.os} ${c.machine}|${major(c.node)}`))].map((key) => {
  const [platform, node] = key.split('|');
  return {
    platform,
    node,
    cells: pythons.map((py) =>
      cells.find((c) => `${c.os} ${c.machine}` === platform && major(c.node) === node && minor(c.python) === py),
    ),
  };
});

const roles: Record<string, string> = { python: 'Python wheel', python_sdist: 'Python sdist', typescript: 'npm archive' };
const writers = [...new Set(packages.checks.map((c) => c.writer))];
const readers = [...new Set(packages.checks.map((c) => c.reader))];
const checkStatus = (w: string, r: string) => packages.checks.find((c) => c.writer === w && c.reader === r)?.status;

const perfRows = [
  { label: 'Warm lexical search, top 8', python: perfPython10k.warm_search_p95_ms, typescript: perfTypescript10k.warm_search_p95_ms },
  { label: 'Process-cold first search', python: perfPython10k.process_cold_search_p95_ms, typescript: perfTypescript10k.process_cold_search_p95_ms },
  { label: 'Filesystem-cold first search', python: perfPython10k.filesystem_cold_search_p95_ms, typescript: perfTypescript10k.filesystem_cold_search_p95_ms },
];
const scaleRows = [
  { label: 'Warm lexical search, top 8', python: perfPython100k.warm_search_p95_ms, typescript: perfTypescript100k.warm_search_p95_ms },
  { label: 'Process-cold first search', python: perfPython100k.process_cold_search_p95_ms, typescript: perfTypescript100k.process_cold_search_p95_ms },
  { label: 'Filesystem-cold first search', python: perfPython100k.filesystem_cold_search_p95_ms, typescript: perfTypescript100k.filesystem_cold_search_p95_ms },
  { label: 'Search at concurrency 16', python: perfPython100k.concurrency.search_top8_ms['16'].p95, typescript: perfTypescript100k.concurrency.search_top8_ms['16'].p95 },
];

const pythonInstall = `python3 -m venv .venv
.venv/bin/python -m pip install chat-context-index==${verification.version}`;

const typescriptRegistry = `@ajitkumar-1001:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=\${GITHUB_PACKAGES_TOKEN}`;

const typescriptInstall = `npm install chat-context-index@npm:${githubPackages.package}@${githubPackages.version}`;

const pythonUsage = `import asyncio

from cci import HistoryStore
from cci.config import Config
from cci.ingest import ingest
from cci.models import InputMessage
from cci.retrieve import retrieve


async def main():
    async with await HistoryStore.open(
        "memory.sqlite", config=Config(cache_backend="none")
    ) as memory:
        await ingest(
            memory,
            memory.history_id,
            [InputMessage(
                external_id="preference-001",
                role="user",
                content="Use UTC for all scheduled reports.",
            )],
            source_id="assistant-app",
            idempotency_key="turn-001",
        )
        result = await retrieve(memory, "UTC", mode="lexical")
        for evidence in result.evidence:
            print(evidence.message_id, evidence.excerpt)


asyncio.run(main())`;

const typescriptUsage = `import { HistoryStore, ingest, prepareContext } from "chat-context-index";

const memory = await HistoryStore.open("conversation.db", { cacheBackend: "none" });
try {
  await ingest(memory, memory.historyId,
    [{ role: "user", content: "Deploy the service in Oslo." }], "chat", "turn-1");
} finally { await memory.close(); }

// This can run in a later process using the same durable file.
const resumed = await HistoryStore.open("conversation.db", { cacheBackend: "none" });
try {
  const context = await prepareContext(resumed, "Oslo", { maxChars: 2000 });
  console.log(context.text); // Pass alongside your instructions, documents, and question.
} finally { await resumed.close(); }`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>chat-context-index 0.1.0 release status</title>
    <meta
      name="description"
      content="Release status, evidence, and known limitations for chat-context-index 0.1.0: the Python package is on PyPI and the TypeScript package is on GitHub Packages; npmjs publication is pending."
    />
  </head>
  <body>
    <header class="wrap hero">
      <p class="eyebrow">Release document · status as of {asOf}</p>
      <h1>chat-context-index <span class="version">0.1.0</span></h1>
      <p class="lede">
        Persistent conversation memory for RAG chats and agents, with bounded tree retrieval.
        Python (<code>cci</code>) and native TypeScript packages read and write the same SQLite history.
      </p>
      <div class="callout" role="note">
        <p>
          <span class="pill pass">Python {verification.version} on PyPI</span>
          <code>pip install chat-context-index=={verification.version}</code> installs the Python package
          (import name <code>cci</code>). It was published from tag
          <a href={`${repo}/tree/${verification.tag}`}><code>{verification.tag}</code></a> at source
          <code>{hosted.source_sha.slice(0, 8)}</code>, which passed hosted regression, all
          {hosted.matrix_cells} package combinations, and every 10k-message hosted Linux performance target.
          <a class="more" href={pypi.url}>PyPI</a> · <a href={verification.publication.release_run_url}>Release run</a>
        </p>
        <p>
          <span class="pill pass">TypeScript {githubPackages.version} on GitHub Packages</span>
          The same CI-tested npm archive, published as <code>{githubPackages.package}</code> because GitHub’s npm
          registry only accepts owner-scoped names; nothing else in it changed.
          <a class="more" href={githubPackages.package_url}>GitHub Packages</a> · <a href={githubPackages.publish_run_url}>Publish run</a>
        </p>
        <p>
          This is a preview. Held-out quality and cost comparisons, a live-model smoke of the published wheel,
          reference-hardware performance, human review, and developer adoption remain open. The package is not
          on npmjs yet: npm 2FA and a publishing token are still missing.
        </p>
      </div>
    </header>

    <nav class="toc" aria-label="Sections">
      <div class="wrap toc-list">
        {toc.map(([key, label]) => <button type="button" data-target={key}>{label}</button>)}
      </div>
    </nav>

    <main class="wrap">
      <section data-section="summary">
        <h2>What 0.1.0 contains</h2>
        <p>
          ContIndex gives an existing RAG chat or agent loop persistent conversation memory. The host keeps its
          document retriever, model, and agent framework; the library supplies conversation context through
          <code>prepare_context()</code> in Python and <code>prepareContext()</code> in TypeScript.
        </p>
        <div class="table">
          <table>
            <thead>
              <tr><th scope="col">Responsibility</th><th scope="col">Approach</th></tr>
            </thead>
            <tbody>
              <tr><th scope="row">Preserve</th><td>Original payloads, source identities, ordering, and replayable ingestion receipts in SQLite.</td></tr>
              <tr><th scope="row">Index</th><td>Explicit incremental chunk summaries and a bounded parent/child hierarchy; unchanged branches reuse summaries.</td></tr>
              <tr><th scope="row">Retrieve</th><td>Bounded model-guided tree navigation with FTS5 fallback. Only original messages become evidence.</td></tr>
              <tr><th scope="row">Prepare context</th><td>Recent messages plus retrieved sources under record, character, and optional tokenizer limits.</td></tr>
              <tr><th scope="row">Answer</th><td>Optional <code>ask()</code> synthesizes from retrieved evidence and checks citations through a supplied provider.</td></tr>
              <tr><th scope="row">Inspect</th><td>Python APIs and a <code>cci</code> CLI for reading, exporting, importing, clearing, and inspecting histories.</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section data-section="gates">
        <h2>Release gates</h2>
        <p class="muted">
          Published build from
          <a href={`${repo}/commit/${hosted.source_sha}`}><code>{hosted.source_sha.slice(0, 7)}</code></a>;
          all {hosted.all_ci_jobs} jobs passed in <a href={hosted.run_url}>its merged-main CI run</a>.
          These results apply to that source and its recorded artifacts; later changes need their own validation.
        </p>
        <div class="table">
          <table class="stack">
            <thead>
              <tr><th scope="col">Gate</th><th scope="col">Status</th><th scope="col">Evidence</th></tr>
            </thead>
            <tbody>
              {gates.map((g) => (
                <tr>
                  <th scope="row">{g.name}</th>
                  <td><span class={`pill ${g.status}`}>{statusLabel[g.status]}</span></td>
                  <td>
                    {g.evidence}
                    {g.href && <a class="more" href={g.href}>Evidence</a>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section data-section="compatibility">
        <h2>Compatibility</h2>
        <p>
          Python 3.11–3.14 (SQLite through <code>apsw</code> 3.53.4.0) and Node.js 22 or later (ESM,
          <code>better-sqlite3</code>). Redis is optional and Python-only. Supported topology: one owning
          application process per history on durable local storage.
        </p>

        <h3>Hosted package matrix</h3>
        <p class="muted">
          Each cell installs the wheel, sdist, and npm archive and runs {hosted.writer_reader_checks_per_cell}
          writer/reader checks. <a href={hosted.run_url}>Verified CI run</a> ·
          <a href={candidateReport}>Retained evidence</a>
        </p>
        <div class="table">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col">Runner</th>
                <th scope="col">Node</th>
                {pythons.map((py) => <th scope="col">Python {py}</th>)}
              </tr>
            </thead>
            <tbody>
              {matrixRows.map((row) => (
                <tr>
                  <th scope="row"><code>{row.platform}</code></th>
                  <td>{row.node}</td>
                  {row.cells.map((c) =>
                    c ? (
                      <td>
                        <span class={`pill ${c.status === 'PASS' ? 'pass' : 'blocked'}`}>
                          {c.status === 'PASS' ? 'Pass' : c.status}
                        </span>
                        <span class="sub">{c.python} · {c.node}</span>
                      </td>
                    ) : (
                      <td>—</td>
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">
          These checks establish installed-package compatibility. Live-model results, reference performance,
          human validation, and registry approval are separate evidence.
        </p>

        <h3>Cross-runtime history files</h3>
        <p class="muted">
          Fresh installs outside the checkout, separate write and read processes, {packages.platform}, Python
          {packages.python}, Node {packages.node}.
        </p>
        <div class="table">
          <table class="matrix">
            <thead>
              <tr>
                <th scope="col">Writer ↓ / Reader →</th>
                {readers.map((r) => <th scope="col">{roles[r] ?? r}</th>)}
              </tr>
            </thead>
            <tbody>
              {writers.map((w) => (
                <tr>
                  <th scope="row">{roles[w] ?? w}</th>
                  {readers.map((r) => {
                    const s = checkStatus(w, r);
                    return (
                      <td>
                        <span class={`pill ${s === 'PASS' ? 'pass' : 'blocked'}`}>{s === 'PASS' ? 'Pass' : (s ?? 'Missing')}</span>
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">Not measured by these checks: {packages.not_measured.join(', ')}.</p>
      </section>

      <section data-section="performance">
        <h2>Performance</h2>
        <p class="muted">
          Published source <code>{hosted.source_sha.slice(0, 8)}</code>, installed from its verified wheel and npm archive,
          was measured on GitHub-hosted Ubuntu with 10,000 and 100,000 messages. All four observed hosts had
          {perfPython10k.hardware.cpu_count} CPUs and approximately {(perfPython10k.hardware.memory_bytes / 2 ** 30).toFixed(2)} GiB RAM;
          CPU models varied between jobs. The fixed 4-CPU/8-GiB reference gate remains
          <code>{perfSummary.fixed_reference_gate}</code>.
          <a class="more" href={performanceRun}>Measurement run</a> · <a href={performanceReport}>Verified observations</a>
        </p>
        <h3>10,000 messages: {hostedTargetsPassed ? 'all hosted targets passed' : 'hosted targets failed'}</h3>
        <div class="table">
          <table>
            <thead>
              <tr>
                <th scope="col">Operation (p95)</th>
                <th scope="col" class="num">Python</th>
                <th scope="col" class="num">TypeScript</th>
                <th scope="col" class="num">Threshold</th>
              </tr>
            </thead>
            <tbody>
              {perfRows.map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    <td class="num">{ms(row.python)} <span class={`pill ${row.python <= 100 ? 'pass' : 'blocked'}`}>{row.python <= 100 ? 'Pass' : 'Fail'}</span></td>
                    <td class="num">{ms(row.typescript)} <span class={`pill ${row.typescript <= 100 ? 'pass' : 'blocked'}`}>{row.typescript <= 100 ? 'Pass' : 'Fail'}</span></td>
                    <td class="num">100 ms</td>
                  </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="notes">
          <li>
            The earlier candidate <code>{perfSummary.previous_candidate.source_sha.slice(0, 8)}</code> failed filesystem-cold
            first search at {ms(earlierColdSearch.python)} (Python) and {ms(earlierColdSearch.typescript)} (TypeScript) p95.
            The compact search index in storage schema version 2 brought it under the 100 ms target.
            Each of the 20 filesystem-cold trials ran <code>sync</code> and <code>drop_caches=3</code> before a fresh
            process; the 20 process-cold trials started a fresh process without clearing the page cache.
          </li>
          <li>
            All four jobs recorded {perfSummary.measurement_scope.concurrency_errors_all_jobs} concurrency errors:
            each ran 3,000 searches across concurrency 1, 4, and 16, plus 64 ingestion batches across concurrency 4 and 16.
            Zero errors does not imply the latency target passed.
          </li>
          <li>
            All four measurement reports are complete. These are GitHub-hosted results, not the fixed
            reference-hardware gate.
          </li>
        </ul>
        <h3>100,000 messages: completed scale observations</h3>
        <p class="note">
          The 100 ms target applies only at 10,000 messages; these are observations. A first search after a
          filesystem-cold start still takes several hundred milliseconds at this size.
        </p>
        <div class="table">
          <table>
            <thead>
              <tr><th scope="col">Operation (p95)</th><th scope="col" class="num">Python</th><th scope="col" class="num">TypeScript</th></tr>
            </thead>
            <tbody>
              {scaleRows.map((row) => (
                <tr><th scope="row">{row.label}</th><td class="num">{ms(row.python)}</td><td class="num">{ms(row.typescript)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section data-section="quality">
        <h2>Retrieval quality</h2>
        <h3>Earlier candidate's Python live smoke <span class={`pill ${smoke.status === 'PASS' ? 'pass' : 'blocked'}`}>{smoke.status}</span></h3>
        <p>
          Not yet repeated for the published wheel <code class="hash">{publishedWheel.sha256}</code>.
          Earlier candidate wheel <code class="hash">{smoke.wheel_sha256}</code> completed a development-fixture smoke with <code>{smoke.model}</code>,
          then retrieved the expected original evidence through tree navigation after reopening SQLite:
          <q>{smoke.checks.evidence[0].excerpt}</q>
          <a class="more" href={smokeReport}>Recorded result</a>
        </p>
        <div class="stats">
          <div class="stat">
            <p class="stat-label">Actual tokens reported by the provider</p>
            <p class="stat-value">{smoke.total_actual_tokens_observed.toLocaleString('en-US')} <span>total</span></p>
            <p>{smoke.actual_input_tokens_observed.toLocaleString('en-US')} input · {smoke.actual_output_tokens_observed} output</p>
          </div>
          <div class="stat">
            <p class="stat-label">Provider calls</p>
            <p class="stat-value">{smoke.attempts} <span>calls</span></p>
